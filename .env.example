# Required by compose.prod.yaml; use immutable, registry-qualified image names in production.
BACKEND_IMAGE=registry.example.com/civicpulse-backend
FRONTEND_IMAGE=registry.example.com/civicpulse-frontend
IMAGE_TAG=replace-with-release-tag

# Database credentials; set real values only in an untracked local .env or secret manager.
POSTGRES_DB=civicpulse
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me

TRIAGE_PROVIDER=rules
GROQ_API_KEY=replace_me
# Ollama is edge-only so it can download a model; it never joins the database network.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
# Optional override when Redis requires authentication or a non-default database.
REDIS_URL=redis://redis:6379/0
# SIMULATED_FAILURE_MODE=none  # none | raise | malformed_json
